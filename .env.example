# ==============================================================================
# DataPulse Backend Environment Configuration
# Copy to .env for local development. NEVER commit real secrets to GitHub.
# ==============================================================================

# Runtime Environment ("development" locally, "production" on Render/Railway)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Upload Safety Limits
MAX_UPLOAD_SIZE_MB=25

# CORS Configuration
# In production, set CORS_ORIGINS strictly to your deployed frontend URL(s)
# (e.g. https://datapulse.ai.studio,https://your-project.vercel.app)
# and leave CORS_ORIGIN_REGEX empty unless preview domains are explicitly required.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,https://datapulse.ai.studio
CORS_ORIGIN_REGEX=https://.*\.(lovable\.app|lovableproject\.com|lovable\.dev)$

# AI & Search Configuration
# Set EMBEDDINGS_ENABLED=false on memory-constrained hosts (512MB-1GB RAM) to use fast TF-IDF search.
EMBEDDINGS_ENABLED=false

# Primary AI Provider (Groq)
AI_PROVIDER=groq
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BACKUP_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Optional Fallback & Retry AI Provider Configuration (Gemini optional fallback)
# Supported fallback providers: gemini, groq, openai, openrouter, openai_compatible
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_WAIT_SECONDS=4.0
AI_FALLBACK_PROVIDER=gemini
# GEMINI_API_KEY=optional_gemini_fallback_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional overrides for other OpenAI-compatible fallback providers:
# AI_FALLBACK_API_KEY=replace_with_fallback_provider_api_key
# AI_FALLBACK_MODEL=gpt-4o-mini
# AI_FALLBACK_BASE_URL=https://api.openai.com/v1

# Security (Generate in production with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_64_char_random_secret_in_production

# Administrator Authorization & Startup Provisioning
# On startup, DataPulse ensures this account exists with is_admin=1 (never overwriting an existing password).
ADMIN_EMAIL=datapulseapplication@gmail.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# Persistent Storage Paths
# Production PostgreSQL metadata database (leave unset locally to use SQLite at DATABASE_PATH):
# DATABASE_URL=postgresql://user:password@host:5432/datapulse?sslmode=require
# Local development defaults:
DATABASE_PATH=datapulse.db
DUCKDB_PATH=datapulse_analytics.duckdb
DATASETS_STORAGE_DIR=storage/datasets
# Production persistent volume example (Render/Railway mounted at /var/data):
# DATABASE_PATH=/var/data/datapulse.db
# DUCKDB_PATH=/var/data/datapulse_analytics.duckdb
# DATASETS_STORAGE_DIR=/var/data/datasets

# Marketplace & Credits
QUERY_COST=1
DATASET_OWNER_REWARD=1

# Curated Public Dataset Library & Optional Cloudflare R2 (S3-Compatible Object Storage)
# Curated datasets are packaged locally under CURATED_DATA_DIR (no R2 required).
# In production without R2 credentials, community uploads are rejected cleanly (503) to avoid ephemeral file loss.
# NEVER commit real R2 credentials to Git. Configure real values only if enabling persistent community uploads.
CURATED_MANIFEST_PATH=data/curated_manifest.json
CURATED_DATA_DIR=data/curated
CURATED_SYNC_ON_STARTUP=true
R2_PERSIST_COMMUNITY_UPLOADS=true
R2_REQUIRED_IN_PRODUCTION=true
# Optional Cloudflare R2 fallback & persistent community uploads:
# R2_ENDPOINT_URL=https://replace_with_cloudflare_account_id.r2.cloudflarestorage.com
# R2_BUCKET_NAME=replace_with_datapulse_curated_bucket
# R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
# R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_REGION=auto
R2_TIMEOUT_SECONDS=30
R2_MAX_RETRIES=3
CURATED_CACHE_MAX_MB=200
CURATED_CACHE_MAX_TABLES=25
CURATED_TARGET_MAX_MB=10
CURATED_TARGET_MAX_ROWS=100000
CURATED_HARD_MAX_MB=25
CURATED_HARD_MAX_ROWS=250000
