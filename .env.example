# ==============================================================================
# DataPulse Backend Environment Configuration
# Copy to .env for local development. NEVER commit real secrets to GitHub.
# ==============================================================================

# Runtime Environment ("development" locally, "production" on Render/Railway)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Upload Safety Limits
MAX_UPLOAD_SIZE_MB=25

# CORS Configuration
# In production, set CORS_ORIGINS strictly to your deployed frontend URL(s)
# (e.g. https://datapulse.ai.studio,https://your-project.vercel.app)
# and leave CORS_ORIGIN_REGEX empty unless preview domains are explicitly required.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://datapulse.ai.studio
CORS_ORIGIN_REGEX=https://.*\.(lovable\.app|lovableproject\.com|lovable\.dev)$

# AI & Search Configuration
# Set EMBEDDINGS_ENABLED=false on memory-constrained hosts (512MB-1GB RAM) to use fast TF-IDF search.
EMBEDDINGS_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_rotated_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Secondary / Fallback AI Provider Configuration (Groq is the default secondary provider)
# Supported fallback providers: groq, gemini, openai, openrouter, openai_compatible
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_WAIT_SECONDS=4.0
AI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BACKUP_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Security (Generate in production with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_64_char_random_secret_in_production

# Administrator Authorization & Startup Provisioning
# On startup, DataPulse ensures this account exists with is_admin=1 (never overwriting an existing password).
ADMIN_EMAIL=datapulseapplication@gmail.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# Persistent Storage Paths
# Local development defaults:
DATABASE_PATH=datapulse.db
DUCKDB_PATH=datapulse_analytics.duckdb
DATASETS_STORAGE_DIR=storage/datasets
# Production persistent volume example (Render/Railway mounted at /var/data):
# DATABASE_PATH=/var/data/datapulse.db
# DUCKDB_PATH=/var/data/datapulse_analytics.duckdb
# DATASETS_STORAGE_DIR=/var/data/datasets

# Marketplace & Credits
QUERY_COST=1
DATASET_OWNER_REWARD=1
