  "components": {
    "schemas": {
      "AuthTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "title": "AuthTokenResponse"
      },
      "Body_upload_dataset_datasets_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "domain": {
            "type": "string",
            "title": "Domain",
            "default": "general"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_dataset_datasets_upload_post"
      },
      "DatasetDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "rows_count": {
            "type": "integer",
            "title": "Rows Count"
          },
          "columns_count": {
            "type": "integer",
            "title": "Columns Count"
          },
          "schema_json": {
            "additionalProperties": true,
            "type": "object",
            "title": "Schema Json"
          },
          "content_summary": {
            "type": "string",
            "title": "Content Summary"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "name",
          "filename",
          "domain",
          "rows_count",
          "columns_count",
          "content_summary",
          "created_at"
        ],
        "title": "DatasetDetailResponse"
      },
      "DatasetListResponse": {
        "properties": {
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/DatasetDetailResponse"
            },
            "type": "array",
            "title": "Datasets"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "datasets",
          "total"
        ],
        "title": "DatasetListResponse"
      },
      "EvaluationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Evaluation status: pending, processing, completed, failed"
          },
          "progress": {
            "type": "integer",
            "title": "Progress",
            "description": "Progress percentage from 0 to 100"
          },
          "quality_score": {
            "type": "number",
            "title": "Quality Score",
            "description": "Overall quality score 0-100"
          },
          "schema_fidelity_score": {
            "type": "number",
            "title": "Schema Fidelity Score",
            "description": "Schema fidelity score 0-100"
          },
          "completeness_score": {
            "type": "number",
            "title": "Completeness Score",
            "description": "Completeness score 0-100"
          },
          "domain_relevance_score": {
            "type": "number",
            "title": "Domain Relevance Score",
            "description": "Domain relevance score 0-100"
          },
          "overall_score": {
            "type": "number",
            "title": "Overall Score",
            "description": "Composite score 0-100"
          },
          "credits_awarded": {
            "type": "integer",
            "title": "Credits Awarded",
            "description": "Credits awarded for this dataset"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "dataset_id",
          "status",
          "progress",
          "quality_score",
          "schema_fidelity_score",
          "completeness_score",
          "domain_relevance_score",
          "overall_score",
          "credits_awarded",
          "updated_at",
          "created_at"
        ],
        "title": "EvaluationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Server health status",
            "default": "ok"
          },
          "cors_regex": {
            "type": "boolean",
            "title": "Cors Regex",
            "description": "Whether CORS_ORIGIN_REGEX is enabled"
          },
          "embeddings": {
            "type": "boolean",
            "title": "Embeddings",
            "description": "Whether EMBEDDINGS_ENABLED is true"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "API Version",
            "default": "1.0.0"
