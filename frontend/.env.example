# Public Frontend Environment Configuration (Vercel / Vite)
# NEVER place GEMINI_API_KEY, SECRET_KEY, or database secrets here — all VITE_* vars are bundled into client JS.

# Production Backend HTTPS API URL (required on Vercel; defaults to http://localhost:8000 only in local dev)
VITE_API_URL=https://datapulse-backend.onrender.com
